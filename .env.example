ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret
SITE_URL=https://your-exact-render-domain.onrender.com
PORT=3000

# Optional: OpenAI-powered mock tests (keep this secret on the server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional semicolon-separated official RSS/Atom feed URLs; discoveries go to admin review, never auto-publish
OFFICIAL_RSS_FEEDS=
